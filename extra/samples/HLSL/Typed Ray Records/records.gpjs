              "type": "Geometry",
              "id": 64,
              "name": "SphereBounds",
              "geometryType": "AxisAlignedBoundingBoxes",
              "vertexBufferBlockId": 21
            }
          ]
        }
      ]
    },
    {
      "type": "Binding",
      "id": 70,
      "name": "Spheres",
      "bindingType": "BufferBlock",
      "blockId": 16
    },
    {
      "type": "Binding",
      "id": 71,
      "name": "Results",
      "bindingType": "BufferBlock",
      "blockId": 31
    },
    {
      "type": "Binding",
      "id": 72,
      "name": "OutputImage",
      "bindingType": "Image",
      "textureId": 2,
      "imageFormat": "Internal",
      "layer": -1
    },
    {
      "type": "Call",
      "id": 80,
      "name": "Trace Typed Records",
      "checked": true,
      "callType": "TraceRays",
      "programId": 50,
